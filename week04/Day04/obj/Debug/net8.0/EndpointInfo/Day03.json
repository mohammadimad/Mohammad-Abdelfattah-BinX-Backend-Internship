      "Bearer": {
        "type": "apiKey",
        "description": "أدخل التوكين بهذا الشكل: Bearer {your token}",
        "name": "Authorization",
        "in": "header"
      }
    }
  },
  "security": [
    {
      "Bearer": [ ]
    }
  ]
