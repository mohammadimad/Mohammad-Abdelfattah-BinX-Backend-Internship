          "AssignedAt" TEXT NOT NULL,&#xD;
          "EndedAt" TEXT NULL,&#xD;
          "IsActive" INTEGER NOT NULL,&#xD;
          "Notes" TEXT NULL,&#xD;
          CONSTRAINT "CK_PatientCareAssignments_EndState" CHECK (([IsActive] = 1 AND [EndedAt] IS NULL) OR ([IsActive] = 0 AND [EndedAt] IS NOT NULL)),&#xD;
          CONSTRAINT "FK_PatientCareAssignments_AspNetUsers_AssignedByUserId" FOREIGN KEY ("AssignedByUserId") REFERENCES "AspNetUsers" ("Id") ON DELETE RESTRICT,&#xD;
          CONSTRAINT "FK_PatientCareAssignments_NurseProfiles_NurseProfileId" FOREIGN KEY ("NurseProfileId") REFERENCES "NurseProfiles" ("Id") ON DELETE CASCADE,&#xD;
