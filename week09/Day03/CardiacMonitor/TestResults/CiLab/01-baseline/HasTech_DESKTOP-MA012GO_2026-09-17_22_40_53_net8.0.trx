          "AcknowledgedAt" TEXT NULL,&#xD;
          "ResolvedByUserId" TEXT NULL,&#xD;
          "ResolvedAt" TEXT NULL,&#xD;
          CONSTRAINT "CK_MedicalAlerts_Severity" CHECK ([Severity] IN ('Medium', 'High', 'Critical')),&#xD;
          CONSTRAINT "CK_MedicalAlerts_Status" CHECK ([Status] IN ('Open', 'Acknowledged', 'Resolved')),&#xD;
          CONSTRAINT "FK_MedicalAlerts_AspNetUsers_AcknowledgedByUserId" FOREIGN KEY ("AcknowledgedByUserId") REFERENCES "AspNetUsers" ("Id") ON DELETE RESTRICT,&#xD;
          CONSTRAINT "FK_MedicalAlerts_AspNetUsers_ResolvedByUserId" FOREIGN KEY ("ResolvedByUserId") REFERENCES "AspNetUsers" ("Id") ON DELETE RESTRICT,&#xD;
