      CREATE TABLE "MedicalAlerts" (&#xD;
          "Id" INTEGER NOT NULL CONSTRAINT "PK_MedicalAlerts" PRIMARY KEY AUTOINCREMENT,&#xD;
          "PatientId" INTEGER NOT NULL,&#xD;
          "VitalSignId" INTEGER NULL,&#xD;
          "Severity" TEXT NOT NULL,&#xD;
          "Status" TEXT NOT NULL,&#xD;
          "Message" TEXT NOT NULL,&#xD;
          "CreatedAt" TEXT NOT NULL,&#xD;
          "AcknowledgedByUserId" TEXT NULL,&#xD;
          "AcknowledgedAt" TEXT NULL,&#xD;
          "ResolvedByUserId" TEXT NULL,&#xD;
          "ResolvedAt" TEXT NULL,&#xD;
          CONSTRAINT "CK_MedicalAlerts_Severity" CHECK ([Severity] IN ('Medium', 'High', 'Critical')),&#xD;
          CONSTRAINT "CK_MedicalAlerts_Status" CHECK ([Status] IN ('Open', 'Acknowledged', 'Resolved')),&#xD;
          CONSTRAINT "FK_MedicalAlerts_AspNetUsers_AcknowledgedByUserId" FOREIGN KEY ("AcknowledgedByUserId") REFERENCES "AspNetUsers" ("Id") ON DELETE RESTRICT,&#xD;
          CONSTRAINT "FK_MedicalAlerts_AspNetUsers_ResolvedByUserId" FOREIGN KEY ("ResolvedByUserId") REFERENCES "AspNetUsers" ("Id") ON DELETE RESTRICT,&#xD;
          CONSTRAINT "FK_MedicalAlerts_Patients_PatientId" FOREIGN KEY ("PatientId") REFERENCES "Patients" ("Id") ON DELETE RESTRICT,&#xD;
          CONSTRAINT "FK_MedicalAlerts_VitalSigns_VitalSignId" FOREIGN KEY ("VitalSignId") REFERENCES "VitalSigns" ("Id") ON DELETE SET NULL&#xD;
      );&#xD;
