      CREATE TABLE "PatientCareAssignments" (&#xD;
          "Id" INTEGER NOT NULL CONSTRAINT "PK_PatientCareAssignments" PRIMARY KEY AUTOINCREMENT,&#xD;
          "PatientId" INTEGER NOT NULL,&#xD;
