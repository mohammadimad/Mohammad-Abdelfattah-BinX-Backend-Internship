          "SystolicBP" INTEGER NOT NULL,&#xD;
          "DiastolicBP" INTEGER NOT NULL,&#xD;
          "RecordedAt" TEXT NOT NULL,&#xD;
          CONSTRAINT "CK_VitalSigns_DiastolicBP" CHECK ([DiastolicBP] BETWEEN 40 AND 130),&#xD;
          CONSTRAINT "CK_VitalSigns_HeartRate" CHECK ([HeartRate] BETWEEN 30 AND 250),&#xD;
          CONSTRAINT "CK_VitalSigns_OxygenSaturation" CHECK (CAST([OxygenSaturation] AS REAL) BETWEEN 50 AND 100),&#xD;
          CONSTRAINT "CK_VitalSigns_SystolicBP" CHECK ([SystolicBP] BETWEEN 70 AND 220),&#xD;
          CONSTRAINT "FK_VitalSigns_Patients_PatientId" FOREIGN KEY ("PatientId") REFERENCES "Patients" ("Id") ON DELETE CASCADE&#xD;
      );&#xD;
