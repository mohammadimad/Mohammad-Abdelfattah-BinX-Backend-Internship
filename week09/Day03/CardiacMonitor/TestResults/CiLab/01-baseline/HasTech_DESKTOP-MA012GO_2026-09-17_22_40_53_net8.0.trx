      CREATE TABLE "DoctorAvailabilitySlots" (&#xD;
          "Id" INTEGER NOT NULL CONSTRAINT "PK_DoctorAvailabilitySlots" PRIMARY KEY AUTOINCREMENT,&#xD;
          "DoctorProfileId" INTEGER NOT NULL,&#xD;
          "DayOfWeek" INTEGER NOT NULL,&#xD;
          "StartTime" time NOT NULL,&#xD;
          "EndTime" time NOT NULL,&#xD;
          "IsActive" INTEGER NOT NULL,&#xD;
          CONSTRAINT "CK_DoctorAvailability_DayOfWeek" CHECK ([DayOfWeek] BETWEEN 0 AND 6),&#xD;
          CONSTRAINT "CK_DoctorAvailability_TimeRange" CHECK ([StartTime] &lt; [EndTime]),&#xD;
          CONSTRAINT "FK_DoctorAvailabilitySlots_DoctorProfiles_DoctorProfileId" FOREIGN KEY ("DoctorProfileId") REFERENCES "DoctorProfiles" ("Id") ON DELETE CASCADE&#xD;
      );&#xD;
