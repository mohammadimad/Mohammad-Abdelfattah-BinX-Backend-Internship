      CREATE TABLE "MedicalAlerts" (&#xD;
          "Id" INTEGER NOT NULL CONSTRAINT "PK_MedicalAlerts" PRIMARY KEY AUTOINCREMENT,&#xD;
          "PatientId" INTEGER NOT NULL,&#xD;
          "VitalSignId" INTEGER NULL,&#xD;
          "Severity" TEXT NOT NULL,&#xD;
          "Status" TEXT NOT NULL,&#xD;
