                "type": "text/javascript",
                "exec": [
                  "pm.test('Doctor is created', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) {",
                  "  const doctor = pm.response.json();",
                  "  pm.collectionVariables.set('doctorProfileId', doctor.id);",
                  "  pm.collectionVariables.set('doctorUserId', doctor.userId);",
