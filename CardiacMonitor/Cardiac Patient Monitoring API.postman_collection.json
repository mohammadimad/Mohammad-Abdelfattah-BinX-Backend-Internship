                "type": "text/javascript",
                "exec": [
                  "const dayNames = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];",
                  "const inside = new Date();",
                  "inside.setUTCDate(inside.getUTCDate() + 1);",
                  "inside.setUTCHours(10, 0, 0, 0);",
                  "const outside = new Date(inside);",
                  "outside.setUTCHours(14, 0, 0, 0);",
                  "pm.collectionVariables.set('doctorAvailabilityDay', dayNames[inside.getUTCDay()]);",
                  "pm.collectionVariables.set('appointmentDateInside', inside.toISOString());",
                  "pm.collectionVariables.set('appointmentDateOutside', outside.toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Availability is created', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) {",
