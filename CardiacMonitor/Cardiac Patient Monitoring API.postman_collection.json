                  "pm.collectionVariables.set('doctorEmail', 'doctor.week7.' + suffix + '@cardiac.com');",
                  "pm.collectionVariables.set('doctorPassword', 'Doctor123!');",
                  "pm.collectionVariables.set('doctorLicenseNumber', 'MD-' + suffix);"
