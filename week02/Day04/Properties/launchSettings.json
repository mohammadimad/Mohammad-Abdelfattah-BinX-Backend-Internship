{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    "http": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true, // 1. تم تعديلها لتصبح true لفتح المتصفح تلقائياً
      "launchUrl": "swagger", // 2. إضافة مسار السواجر ليفتح عليه مباشرة
      "applicationUrl": "http://localhost:5234",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    "https": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true, // 1. تم تعديلها لتصبح true لفتح المتصفح تلقائياً
      "launchUrl": "swagger", // 2. إضافة مسار السواجر ليفتح عليه مباشرة
      "applicationUrl": "https://localhost:7194;http://localhost:5234",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    }
  }
}